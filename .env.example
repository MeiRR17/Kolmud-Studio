# Copy to .env and adjust. Every value here is optional; these are the defaults.

# --- ASR (mlx-whisper, runs on the Mac GPU) ---
HEBREW_ASR_MODEL=mlx-community/ivrit-ai-whisper-large-v3-turbo-mlx
ENGLISH_ASR_MODEL=mlx-community/whisper-large-v3-mlx
# Prime Whisper with Torah vocabulary (off: ivrit-ai doesn't need it and it can drop the first word)
HEBREW_ASR_CONTEXT_PROMPT=false

# --- LLM translation: ollama | openai | anthropic ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_NUM_CTX=16384
# Any OpenAI-compatible endpoint works (OpenAI, Gemini, OpenRouter, LM Studio...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hebrew characters per LLM request; lower it if a local model truncates or drops content
TRANSLATION_CHUNK_CHARS=1400

# --- TTS: xtts | elevenlabs ---
TTS_ENGINE=xtts
# auto = Metal (MPS) with automatic CPU fallback; set cpu if MPS output sounds wrong
TTS_DEVICE=auto
# XTTS-v2 weights are under the Coqui Public Model License (non-commercial use only).
# Read https://coqui.ai/cpml — set true only if you accept it.
XTTS_ACCEPT_CPML=false
XTTS_TEMPERATURE=0.65
XTTS_SPEED=1.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
SEGMENT_PAUSE_MS=600
